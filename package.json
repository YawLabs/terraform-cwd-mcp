{
  "name": "@yawlabs/terraform-cwd-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.YawLabs/terraform-cwd-mcp",
  "description": "Terraform MCP server for what is true in THIS working directory: exact pinned provider schemas, saved plans, state (redacted), local modules and provider-upgrade impact",
  "license": "MIT",
  "author": "Yaw Labs <contact@yaw.sh> (https://yaw.sh)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "terraform-cwd-mcp": "bin/terraform-cwd-mcp.mjs"
  },
  "files": [
    "bin/terraform-cwd-mcp.mjs",
    "dist",
    "vendor",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "node scripts/lint.mjs check src/ bin/ scripts/",
    "lint:fix": "node scripts/lint.mjs check --write src/ bin/ scripts/",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:tsc": "tsc --noEmit",
    "check:compliance": "node scripts/check-compliance.mjs",
    "check:oam-floor": "node scripts/check-oam-floor.mjs",
    "test:ci": "npm run build && npm test",
    "prepublishOnly": "npm run build",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "web-tree-sitter": "0.27.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "hono": "^4.13.5",
    "@hono/node-server": "^1.19.15",
    "postcss": "^8.5.23",
    "ip-address": "^10.7.3",
    "proxy-addr": "^2.0.8",
    "fast-uri": "^3.1.8",
    "qs": "^6.16.0",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.11",
    "@types/node": "^26.0.0",
    "@yawlabs/mcp-compliance": "^0.20.4",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "terraform",
    "terraform-mcp",
    "terraform-provider",
    "provider-schema",
    "opentofu",
    "hcl",
    "infrastructure-as-code",
    "iac",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "devtools",
    "ai",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YawLabs/terraform-cwd-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/YawLabs/terraform-cwd-mcp/issues"
  },
  "homepage": "https://yaw.sh/mcp-servers/terraform-cwd-mcp/"
}
